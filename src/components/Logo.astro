---

---
<a href="/" class="logo" aria-label="Block and Site, home">
  <svg class="logo__mark" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
    <rect x="1" y="1" width="10" height="10" rx="2" fill="#43A4F4" />
    <rect x="13" y="1" width="10" height="10" rx="2" fill="#F4434C" />
    <rect x="1" y="13" width="10" height="10" rx="2" fill="#F2F6F9" />
    <rect x="13" y="13" width="10" height="10" rx="2" fill="#F4EB43" />
  </svg>
  <span class="logo__word">Block and Site</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
  }
  .logo:hover { color: var(--text); }
  .logo__word {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.3125rem;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
</style>
