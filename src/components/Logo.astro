---
import { withBase } from '../lib/paths';
---
<a href={withBase("/")} class="logo" aria-label="Block and Site, home">
  <svg class="logo__mark" viewBox="0 0 48 48" width="30" height="30" aria-hidden="true">
    <rect x="2" y="2" width="30" height="30" rx="5" fill="#43A4F4" />
    <rect x="16" y="16" width="30" height="30" rx="5" fill="#F4EB43" />
    <path d="M21 16H32V27A5 5 0 0 1 27 32H16V21A5 5 0 0 1 21 16Z" fill="#F4434C" />
  </svg>
  <span class="logo__word">Block and Site</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
  }
  .logo:hover { color: var(--text); }
  .logo__word {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.3125rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
</style>
