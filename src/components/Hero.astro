---
---

<section class="hero" aria-labelledby="hero-title">
  <!-- Signature visual: blocks that keep rebuilding into a website, the logo, a phone, a wave and a vortex,
       behind the headline. WebGL, loaded after the page is ready (src/scripts/hero-scene.ts). -->
  <canvas class="hero__canvas" aria-hidden="true"></canvas>
  <div class="container hero__inner">
    <div class="hero__copy">
      <h1 id="hero-title">Websites that get local businesses more calls.</h1>
      <p class="hero__sub">
        We rebuild outdated small-business websites in Carmel and Fishers so they load fast, work on phones, and show
        up on Google. You own your domain, and the code is yours at final payment.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#contact">Get a free website review</a>
        <a class="hero__link" href="#packages">See packages</a>
      </div>
    </div>
  </div>
  <p class="hero__hint" aria-hidden="true" hidden></p>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');
  const canvas = document.querySelector<HTMLCanvasElement>('.hero__canvas');
  const copy = document.querySelector<HTMLElement>('.hero__copy');
  const hint = document.querySelector<HTMLElement>('.hero__hint');

  const start = () =>
    import('../scripts/hero-scene').then(({ initHeroScene }) => {
      if (!hero || !canvas || !copy) return;
      const scene = initHeroScene(canvas, hero, copy);
      if (!scene) return;
      requestAnimationFrame(() => hero.classList.add('is-live'));
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        import('../scripts/follow-scene').then(({ initFollow }) => initFollow(scene, hero));
      }
      if (hint && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        hint.textContent = matchMedia('(pointer: fine)').matches
          ? 'Drag to spin the blocks. Click to rebuild them.'
          : 'Tap to rebuild the blocks.';
        hint.hidden = false;
      }
    });

  // Start on the visitor's first interaction (or after a few seconds) so the scene never competes with
  // the page's first load.
  let started = false;
  const events = ['pointermove', 'pointerdown', 'touchstart', 'scroll', 'keydown'] as const;
  const go = () => {
    if (started) return;
    started = true;
    events.forEach((e) => removeEventListener(e, go));
    start();
  };
  const arm = () => {
    events.forEach((e) => addEventListener(e, go, { once: true, passive: true }));
    setTimeout(go, 3500);
  };
  if (document.readyState === 'complete') arm();
  else addEventListener('load', arm, { once: true });
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(600px, calc(100svh - 72px), 900px);
    /* faint blueprint grid on the 8px system */
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 32px 32px;
    overflow: hidden;
    touch-action: pan-y;
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 900ms var(--ease);
  }
  .hero.is-live .hero__canvas {
    opacity: 1;
  }
  .hero.is-live {
    cursor: grab;
  }
  .hero.is-live:active {
    cursor: grabbing;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: var(--s6);
    pointer-events: none;
  }
  .hero__copy {
    max-width: 40rem;
    pointer-events: auto;
    cursor: auto;
    text-shadow: 0 2px 28px rgb(0 0 0 / 0.85);
  }
  .hero h1 {
    max-width: 14ch;
  }
  .hero__sub {
    margin-top: var(--s3);
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: 1.55;
    max-width: 46ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3);
    margin-top: var(--s4);
  }
  .hero__link {
    color: var(--text);
    font-weight: 600;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .hero__link:hover {
    color: var(--blue);
  }
  .hero__hint {
    position: absolute;
    right: var(--gutter);
    bottom: var(--s3);
    z-index: 1;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.875rem;
    pointer-events: none;
    user-select: none;
  }

  /* Narrow screens: text on top, the blocks build in the space below it and rise up behind the buttons. */
  @media (max-width: 899px) {
    .hero {
      align-items: flex-start;
      min-height: 0;
    }
    .hero__inner {
      padding-block: var(--s5) clamp(320px, 92vw, 420px);
    }
    .hero__hint {
      left: var(--gutter);
      right: auto;
      bottom: var(--s2);
    }
  }
</style>
