---
---

<section class="hero on-ink" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__copy">
      <h1 id="hero-title">Websites that get local businesses more calls.</h1>
      <p class="hero__sub">
        We rebuild outdated small-business websites in Carmel and Fishers so they load fast, work on phones, and show
        up on Google. You own your domain, and the code is yours at final payment.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#contact">Get a free website review</a>
        <a class="hero__link" href="#packages">See packages</a>
      </div>
    </div>

    <!-- Signature visual: a phone-sized site assembling from blocks. The yellow block is the call button. -->
    <div class="hero__art" aria-hidden="true">
      <div class="phone">
        <div class="phone__screen">
          <div class="blk blk--nav" style="--i:0"><span></span><span></span><span></span></div>
          <div class="blk blk--banner" style="--i:1"></div>
          <div class="blk blk--line" style="--i:2"></div>
          <div class="blk blk--line blk--short" style="--i:3"></div>
          <div class="blk blk--call" style="--i:4">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
            Call now
          </div>
          <div class="blk-row" style="--i:5"><div class="blk blk--tile"></div><div class="blk blk--tile"></div></div>
          <div class="blk blk--line" style="--i:6"></div>
          <div class="blk blk--line blk--short" style="--i:7"></div>
          <div class="blk blk--footer" style="--i:8"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background-color: var(--ink);
    /* faint blueprint grid on the 8px system */
    background-image:
      linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 32px 32px;
    color: var(--on-ink);
    overflow: hidden;
  }
  .hero__inner {
    display: grid;
    gap: var(--s5);
    padding-block: var(--s6);
  }
  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.35fr 1fr;
      align-items: center;
      padding-block: var(--s7);
    }
  }
  .hero h1 {
    max-width: 14ch;
  }
  .hero__sub {
    margin-top: var(--s3);
    color: var(--on-ink-muted);
    font-size: var(--step-1);
    line-height: 1.55;
    max-width: 46ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3);
    margin-top: var(--s4);
  }
  .hero__link {
    color: var(--on-ink);
    font-weight: 600;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .hero__link:focus-visible,
  .hero .btn:focus-visible {
    outline-color: var(--signal);
  }

  /* ---- Phone built from blocks ---- */
  .hero__art {
    display: flex;
    justify-content: center;
  }
  .phone {
    width: min(68vw, 260px);
    aspect-ratio: 9 / 17;
    padding: 12px;
    border: 3px solid var(--limestone);
    border-radius: 18px;
    background: var(--ink);
    box-shadow: 10px 10px 0 rgb(227 226 220 / 0.14);
  }
  .phone__screen {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 10px;
    border-radius: 8px;
    background: var(--paper);
    overflow: hidden;
  }
  .blk,
  .blk-row {
    animation: snap 520ms var(--ease) both;
    animation-delay: calc(120ms + var(--i, 0) * 70ms);
  }
  .blk-row .blk { animation: none; }
  .blk {
    border-radius: var(--radius);
    background: var(--limestone);
  }
  .blk--nav {
    display: flex;
    gap: 6px;
    padding: 6px;
    background: var(--ink);
  }
  .blk--nav span {
    width: 14px;
    height: 6px;
    background: var(--limestone-deep);
  }
  .blk--nav span:first-child { width: 22px; background: var(--signal); }
  .blk--banner { flex: 0 0 34%; background: var(--limestone-deep); }
  .blk--line { height: 10px; }
  .blk--short { width: 62%; }
  .blk--call {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 40px;
    margin-block: 4px;
    background: var(--signal);
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    color: var(--ink);
    font-weight: 800;
    font-stretch: 112%;
    font-size: 0.875rem;
  }
  .blk-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    flex: 1 1 auto;
    max-height: 72px;
  }
  .blk--tile { background: var(--limestone); }
  .blk--footer { margin-top: auto; height: 28px; background: var(--ink); }

  @keyframes snap {
    from {
      opacity: 0;
      transform: translateY(-18px);
    }
    70% {
      opacity: 1;
      transform: translateY(2px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
