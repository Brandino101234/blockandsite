---
// Placeholder examples. Replace only with real, client-approved projects and results (see CLAUDE.md).
const examples = [
  { business: '[Business name]', meta: '[Industry], [City]', result: '[Result: real, client-approved outcome only]' },
  { business: '[Business name]', meta: '[Industry], [City]', result: '[Result: real, client-approved outcome only]' },
];
---

<section id="work" class="section" aria-labelledby="work-title">
  <div class="container">
    <div class="section-head">
      <h2 id="work-title">Before and after</h2>
      <p>[Intro: one sentence about the redesigns shown here]</p>
    </div>
    <ul class="work" role="list">
      {
        examples.map((ex) => (
          <li class="example">
            <div class="example__pair">
              <figure class="shot shot--before">
                <div class="shot__frame"><span>[Before screenshot]</span></div>
                <figcaption>Before</figcaption>
              </figure>
              <figure class="shot shot--after">
                <div class="shot__frame"><span>[After screenshot]</span></div>
                <figcaption>After</figcaption>
              </figure>
            </div>
            <h3>{ex.business}</h3>
            <p class="example__meta">{ex.meta}</p>
            <p class="example__result">{ex.result}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .work {
    display: grid;
    gap: var(--s5);
    list-style: none;
  }
  @media (min-width: 900px) {
    .work { grid-template-columns: 1fr 1fr; gap: var(--s4); }
  }
  .example__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s1);
    margin-bottom: var(--s3);
  }
  .shot { margin: 0; }
  .shot__frame {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    padding: var(--s2);
    border-radius: var(--radius);
    text-align: center;
    font-size: var(--step--1);
  }
  .shot--before .shot__frame {
    background: repeating-linear-gradient(135deg, var(--limestone) 0 10px, #d9d8d1 10px 20px);
    color: var(--ink-soft);
  }
  .shot--after .shot__frame {
    background: var(--paper);
    border: 2px solid var(--ink);
    box-shadow: inset 0 6px 0 var(--signal);
    color: var(--ink);
  }
  .shot figcaption {
    margin-top: var(--s1);
    font-weight: 700;
    font-size: var(--step--1);
  }
  .example__meta { color: var(--ink-soft); margin-top: 0.25rem; }
  .example__result { margin-top: var(--s1); }
</style>
