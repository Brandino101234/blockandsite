---
import { site } from '../config/site';
---

<section id="contact" class="section section--stone" aria-labelledby="contact-title">
  <div class="container contact">
    <div class="contact__intro">
      <div class="section-head">
        <h2 id="contact-title">Get a free website review</h2>
        <p>Tell us about your business and your current website. We’ll look it over and reply by email {site.responseTime} with what we’d fix first.</p>
      </div>
      <p class="contact__alt">
        Prefer email? Write to us at <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
      <p class="contact__area">Serving Carmel, Fishers, and [nearby areas].</p>
    </div>

    <div class="contact__panel">
      <form id="review-form" class="form" novalidate aria-describedby="form-note">
        <p id="form-note" class="form__note">Fields marked optional can be left blank.</p>

        <div class="form__row">
          <div class="field">
            <label for="firstname">First name</label>
            <input id="firstname" name="firstname" type="text" autocomplete="given-name" required maxlength="100" aria-describedby="firstname-error" />
            <p class="field__error" id="firstname-error" hidden></p>
          </div>
          <div class="field">
            <label for="lastname">Last name</label>
            <input id="lastname" name="lastname" type="text" autocomplete="family-name" required maxlength="100" aria-describedby="lastname-error" />
            <p class="field__error" id="lastname-error" hidden></p>
          </div>
        </div>

        <div class="form__row">
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="200" aria-describedby="email-error" />
            <p class="field__error" id="email-error" hidden></p>
          </div>
          <div class="field">
            <label for="phone">Phone <span class="field__optional">(optional)</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" aria-describedby="phone-error" />
            <p class="field__error" id="phone-error" hidden></p>
          </div>
        </div>

        <div class="form__row">
          <div class="field">
            <label for="company">Business name</label>
            <input id="company" name="company" type="text" autocomplete="organization" required maxlength="200" aria-describedby="company-error" />
            <p class="field__error" id="company-error" hidden></p>
          </div>
          <div class="field">
            <label for="website">Current website <span class="field__optional">(optional)</span></label>
            <input id="website" name="website" type="text" inputmode="url" autocomplete="url" placeholder="yourbusiness.com" maxlength="300" aria-describedby="website-hint website-error" />
            <p class="field__hint" id="website-hint">Leave blank if you don’t have one yet.</p>
            <p class="field__error" id="website-error" hidden></p>
          </div>
        </div>

        <div class="field">
          <label for="message">What’s not working with your site? <span class="field__optional">(optional)</span></label>
          <textarea id="message" name="message" rows="5" maxlength="2000" aria-describedby="message-error"></textarea>
          <p class="field__error" id="message-error" hidden></p>
        </div>

        <!-- Spam trap: hidden from people, filled in by bots. Never sent to HubSpot. -->
        <div class="hp" aria-hidden="true">
          <label for="hp_company_url">Leave this field empty</label>
          <input id="hp_company_url" name="hp_company_url" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form__actions">
          <button class="btn btn--primary form__submit" type="submit">
            <span class="form__spinner" aria-hidden="true"></span>
            <span class="form__label">Request my review</span>
          </button>
          <p class="form__privacy">We store your details in our CRM (HubSpot) and never sell them. <a href="/privacy">Privacy policy</a></p>
        </div>

        <div class="form__status" role="alert" tabindex="-1" hidden></div>
      </form>

      <div class="form-success" tabindex="-1" hidden>
        <span class="form-success__mark" aria-hidden="true"></span>
        <h3>Review requested</h3>
        <p class="form-success__msg"></p>
      </div>
    </div>
  </div>
</section>

<script>
  import { initReviewForm } from '../scripts/hubspot-form';
  initReviewForm();
</script>

<style>
  .contact {
    display: grid;
    gap: var(--s4);
  }
  @media (min-width: 960px) {
    .contact { grid-template-columns: 1fr 1.5fr; gap: var(--s6); align-items: start; }
  }
  .contact__intro .section-head { margin-bottom: var(--s3); }
  .contact__alt, .contact__area { color: var(--ink-soft); }
  .contact__area { margin-top: var(--s2); }

  .contact__panel {
    padding: var(--s4) var(--s3);
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: 8px 8px 0 var(--ink);
  }
  @media (min-width: 600px) {
    .contact__panel { padding: var(--s5) var(--s4); }
  }

  .form { display: grid; gap: var(--s3); }
  .form__note { font-size: var(--step--1); color: var(--ink-soft); }
  .form__row { display: grid; gap: var(--s3); }
  @media (min-width: 600px) {
    .form__row { grid-template-columns: 1fr 1fr; }
  }

  .field { display: grid; gap: 0.375rem; align-content: start; }
  .field label { font-weight: 600; }
  .field__optional { font-weight: 400; color: var(--ink-soft); }
  .field input,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.75rem 0.875rem;
    background: var(--white);
    border: 1.5px solid #6b7389;
    border-radius: var(--radius);
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    transition: border-color 140ms var(--ease), box-shadow 140ms var(--ease);
  }
  .field textarea { resize: vertical; min-height: 128px; }
  .field input::placeholder { color: #6b7389; }
  .field input:hover,
  .field textarea:hover { border-color: var(--ink); }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    border-color: var(--steel);
    box-shadow: 0 0 0 3px rgb(47 93 138 / 0.35);
  }
  .field [aria-invalid='true'] {
    border-color: var(--error);
    box-shadow: 0 0 0 1px var(--error);
  }
  .field__hint { font-size: var(--step--1); color: var(--ink-soft); }
  .field__error {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    color: var(--error);
    font-size: var(--step--1);
    font-weight: 600;
  }
  .field__error::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    background: var(--error);
    transform: translateY(-1px);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__actions {
    display: grid;
    gap: var(--s2);
    margin-top: var(--s1);
  }
  .form__submit { width: 100%; }
  @media (min-width: 600px) {
    .form__submit { width: auto; justify-self: start; }
  }
  .form__privacy { font-size: var(--step--1); color: var(--ink-soft); }

  .form__spinner {
    display: none;
    width: 14px;
    height: 14px;
    background: var(--ink);
    animation: block-spin 900ms steps(4) infinite;
  }
  .form[aria-busy='true'] .form__spinner { display: inline-block; }
  .form[aria-busy='true'] .form__submit { cursor: progress; opacity: 0.85; }
  @keyframes block-spin {
    to { transform: rotate(360deg); }
  }

  .form__status {
    padding: var(--s2);
    border-left: 6px solid var(--error);
    background: #fdf0ef;
    color: var(--ink);
  }
  .form__status:focus { outline: none; }
  .form__status :global(strong) { color: var(--error); }

  .form-success { display: grid; gap: var(--s2); }
  .form-success[hidden] { display: none; }
  .form-success:focus { outline: none; }
  .form-success__mark {
    width: 40px;
    height: 40px;
    background: var(--signal);
    border: 2px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    animation: success-drop 420ms var(--ease) both;
  }
  .form-success h3 { font-size: var(--step-2); }
  @keyframes success-drop {
    from { transform: translateY(-14px); opacity: 0; }
    to { transform: none; opacity: 1; }
  }
</style>
