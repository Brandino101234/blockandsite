---
import { site } from '../config/site';
---

<section id="packages" class="section section--alt" aria-labelledby="packages-title">
  <div class="container">
    <div style="--marker: var(--red)" class="section-head">
      <h2 id="packages-title">Packages</h2>
      <p>Three redesign packages, plus a monthly care plan so your site stays fast and working after launch. Every package is mobile-first, and you own your domain.</p>
    </div>

    <ul class="packages" role="list">
      {
        site.packages.map((pkg) => (
          <li class="pkg">
            <div class="pkg__stack" aria-hidden="true">
              {Array.from({ length: pkg.blocks }).map((_, i) => (
                <span class={`pkg__block pkg__block--${['blue', 'red', 'yellow'][pkg.blocks - 1 - i]}`} />
              ))}
            </div>
            <h3 class="pkg__name">{pkg.name}</h3>
            <p class="pkg__price">{pkg.price} <span>one-time</span></p>
            <p class="pkg__summary">{pkg.summary}</p>
            <ul class="pkg__features">
              {pkg.features.map((f) => <li>{f}</li>)}
            </ul>
            <a class="btn btn--secondary pkg__cta" href="#contact">
              Get a free review<span class="visually-hidden"> about {pkg.name}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="compare">
      <h3 class="compare__title">Compare packages</h3>
      <div class="compare__scroll">
        <table class="compare__table">
          <caption class="visually-hidden">What each package includes</caption>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Feature</span></th>
              {site.packages.map((pkg) => (
                <th scope="col">
                  <span class="compare__pkg">{pkg.name}</span>
                  <span class="compare__price">{pkg.price}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {site.comparison.map((row) => (
              <tr>
                <th scope="row">{row.feature}</th>
                {row.values.map((v) => (
                  <td>
                    {v === true ? (
                      <><span class="compare__yes" aria-hidden="true" /><span class="visually-hidden">Included</span></>
                    ) : v === false ? (
                      <><span class="compare__no" aria-hidden="true">–</span><span class="visually-hidden">Not included</span></>
                    ) : (
                      v
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="care">
      <div class="care__head">
        <h3>Monthly {site.carePlan.name.toLowerCase()}</h3>
        <p class="care__price">{site.carePlan.price} <span>per month</span></p>
      </div>
      <ul class="care__list" role="list">
        {site.carePlan.includes.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .packages {
    display: grid;
    gap: var(--s3);
    list-style: none;
  }
  @media (min-width: 860px) {
    .packages { grid-template-columns: repeat(3, 1fr); align-items: stretch; }
  }
  .pkg {
    display: flex;
    flex-direction: column;
    padding: var(--s4) var(--s3);
    background: var(--surface);
    border: var(--border);
    border-radius: var(--radius);
  }
  /* Block stack shows relative scope: each package adds a block (blue, then red, then yellow) */
  .pkg__stack {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 4px;
    height: calc(3 * 20px + 2 * 4px);
    margin-bottom: var(--s3);
  }
  .pkg__block {
    width: 20px;
    height: 20px;
    border-radius: 3px;
  }
  .pkg__block--blue { background: var(--blue); }
  .pkg__block--red { background: var(--red); }
  .pkg__block--yellow { background: var(--yellow); }
  .pkg__name { font-size: var(--step-2); }
  .pkg__price {
    margin-top: var(--s1);
    font-family: var(--font-head);
    font-size: var(--step-1);
    font-weight: 700;
  }
  .pkg__price span { font-family: var(--font-body); font-weight: 400; color: var(--text-muted); font-size: var(--step-0); }
  .pkg__summary {
    margin-top: var(--s2);
    color: var(--text-muted);
  }
  .pkg__features {
    display: grid;
    gap: var(--s1);
    margin-block: var(--s3);
    list-style: none;
  }
  .pkg__features li {
    position: relative;
    padding-left: 1.25rem;
  }
  .pkg__features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--blue);
  }
  .pkg__cta { margin-top: auto; width: 100%; }

  /* ---- Comparison table ---- */
  .compare {
    margin-top: var(--s5);
  }
  .compare__title {
    font-size: var(--step-2);
    margin-bottom: var(--s3);
  }
  .compare__scroll {
    overflow-x: auto;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .compare__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }
  .compare__table { table-layout: fixed; }
  .compare__table thead th:first-child { width: 40%; }
  @media (max-width: 599px) {
    .compare__table { font-size: 0.875rem; }
    .compare__table thead th:first-child { width: 30%; }
    .compare__table thead th { padding-inline: 0.125rem; }
    .compare__table th,
    .compare__table td { padding: 0.625rem 0.25rem; }
    .compare__table tbody th { padding-left: 0.625rem; }
    .compare__pkg { font-size: 0.8125rem; line-height: 1.2; }
    .compare__price { font-size: 0.8125rem; }
  }
  .compare__table th,
  .compare__table td {
    padding: 0.75rem var(--s2);
    border-bottom: var(--border);
    text-align: center;
    vertical-align: middle;
  }
  .compare__table tbody tr:last-child > * { border-bottom: 0; }
  .compare__table tbody th {
    text-align: left;
    font-weight: 500;
    color: var(--text);
  }
  .compare__table thead th {
    padding-block: var(--s2);
    background: var(--surface-2);
  }
  .compare__pkg {
    display: block;
    font-weight: 700;
    font-size: var(--step-0);
  }
  .compare__price {
    display: block;
    color: var(--text-muted);
    font-weight: 400;
  }
  .compare__table td { color: var(--text); font-weight: 600; }
  .compare__yes {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: var(--blue);
  }
  .compare__no { color: var(--text-muted); font-weight: 400; }

  .care {
    display: grid;
    gap: var(--s3);
    margin-top: var(--s3);
    padding: var(--s4) var(--s3);
    background: var(--surface-2);
    border-radius: var(--radius);
  }
  @media (min-width: 860px) {
    .care { grid-template-columns: 1fr auto; align-items: center; padding-inline: var(--s4); }
  }
  .care__price {
    margin-top: var(--s1);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--step-1);
  }
  .care__price span { font-family: var(--font-body); font-weight: 400; color: var(--text-muted); font-size: var(--step-0); }
  .care__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1);
    list-style: none;
  }
  .care__list li {
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-weight: 600;
  }
</style>
