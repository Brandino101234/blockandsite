---
const problems = [
  {
    title: 'Slow to load',
    body: 'When a page takes too long, people tap back and call the next business on the list. We build lean sites that load quickly on a phone signal.',
    icon: '<path d="M12 13l4-4"/><path d="M3.3 19a10 10 0 1 1 17.4 0"/>',
  },
  {
    title: 'Hard to use on a phone',
    body: 'Tiny text, menus that don’t open, buttons too small to tap. We design for phones first, then scale up to desktop.',
    icon: '<rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/>',
  },
  {
    title: 'Not showing up on Google',
    body: 'If customers can’t find you when they search, they find a competitor. We set up the page titles, descriptions, and business details Google reads.',
    icon: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>',
  },
  {
    title: 'No easy way to call or book',
    body: 'A buried phone number or a broken contact form costs you jobs. We put calling, booking, and contact one tap away on every page.',
    icon: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>',
  },
];
---

<section id="problems" class="section" aria-labelledby="problems-title">
  <div class="container">
    <div style="--marker: var(--blue)" class="section-head">
      <h2 id="problems-title">What we fix</h2>
      <p>We work with HVAC companies, roofers, restaurants, dentists, landscapers, and other local businesses whose websites are holding them back.</p>
    </div>
    <ul class="problems" role="list">
      {
        problems.map((p) => (
          <li class="problem">
            <span class="problem__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
            </span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .problems {
    display: grid;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  @media (min-width: 720px) {
    .problems { grid-template-columns: 1fr 1fr; }
    .problem:nth-child(odd) { border-right: var(--border); padding-right: var(--s4); }
    .problem:nth-child(even) { padding-left: var(--s4); }
  }
  .problem {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--s2);
    row-gap: var(--s1);
    padding-block: var(--s4);
    border-bottom: var(--border);
  }
  .problem__icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    background: var(--surface-2);
    color: var(--blue);
    border-radius: var(--radius-block);
  }
  .problem p { color: var(--text-muted); }
</style>
