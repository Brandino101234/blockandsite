---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Problems from '../components/Problems.astro';
import Packages from '../components/Packages.astro';
import Work from '../components/Work.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { site, isPlaceholder } from '../config/site';
import { absoluteUrl } from '../lib/paths';

const a = site.mailingAddress;
const addressReady = ![a.street, a.city, a.postalCode].some(isPlaceholder);

// LocalBusiness schema. Only confirmed facts go here; placeholder fields are left out automatically.
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': absoluteUrl('/#business'),
  name: site.name,
  description: site.description,
  url: absoluteUrl('/'),
  email: site.email,
  logo: absoluteUrl('/brand/app-icon-512.png'),
  image: absoluteUrl('/og-image.png'),
  ...(isPlaceholder(site.phone) ? {} : { telephone: site.phone }),
  ...(addressReady
    ? { address: { '@type': 'PostalAddress', streetAddress: a.street, addressLocality: a.city, addressRegion: a.region, postalCode: a.postalCode, addressCountry: 'US' } }
    : {}),
  areaServed: [
    { '@type': 'City', name: 'Carmel', containedInPlace: { '@type': 'State', name: 'Indiana' } },
    { '@type': 'City', name: 'Fishers', containedInPlace: { '@type': 'State', name: 'Indiana' } },
  ],
  founder: site.founders.map((f) => ({ '@type': 'Person', name: f.name })),
  knowsAbout: ['Website redesign', 'Mobile-first web design', 'Local SEO', 'Website hosting and maintenance'],
};
---

<Base
  title="Block and Site | Website redesign for local businesses in Carmel & Fishers, IN"
  description="Fast, mobile-first website redesigns for local small businesses in Carmel and Fishers, Indiana. Built to get calls and bookings. Get a free website review."
  schema={[localBusiness]}
>
  <Header />
  <main id="main">
    <Hero />
    <Problems />
    <Packages />
    <Work />
    <Process />
    <About />
    <Contact />
  </main>
  <Footer />
</Base>
