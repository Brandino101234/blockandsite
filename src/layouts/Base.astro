---
import '../styles/global.css';
import { site } from '../config/site';
import { isHubSpotConfigured, hubspotTrackingSrc } from '../config/hubspot';

interface Props {
  title: string;
  description: string;
  /** JSON-LD objects to embed on this page */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, schema = [], noindex = false } = Astro.props;
const base = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, base).href;
const ogImage = new URL('/og-image.png', base).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#02131C" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/bricolage.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/figtree.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Block and Site: websites that get local businesses more calls" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    {
      isHubSpotConfigured && (
        /* HubSpot tracking code. Injected after the page has loaded so it doesn't slow first paint.
           Records page views so HubSpot shows which pages a lead viewed. */
        <script is:inline define:vars={{ src: hubspotTrackingSrc }}>
          (function () {
            function load() {
              if (document.getElementById('hs-script-loader')) return;
              var s = document.createElement('script');
              s.id = 'hs-script-loader';
              s.async = true;
              s.defer = true;
              s.src = src;
              document.head.appendChild(s);
            }
            function schedule() {
              if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 2500 });
              else setTimeout(load, 1200);
            }
            if (document.readyState === 'complete') schedule();
            else window.addEventListener('load', schedule);
          })();
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <slot />
  </body>
</html>
